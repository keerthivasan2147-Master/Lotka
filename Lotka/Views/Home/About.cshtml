@{
    ViewData["Title"] = "About Us | Heritage (1976) & Autonomous Future";
}

<!-- ─── HERO: Full-width 1976 Heritage to AI Era with Separated Content (Picture Way) ─── -->
<section class="lotka-fullwidth-hero position-relative">
    <div class="fullwidth-image-wrapper">
        <img src="~/images/about-hero.png"
             alt="LOTKA Logistics Heritage 1976 to Autonomous AI Future"
             class="fullwidth-hero-img" />
    </div>

    <!-- Visually hidden heading for SEO -->
    <h1 class="visually-hidden">About LOTKA – 1976 Maritime Heritage Meets Autonomous AI Logistics</h1>

    <!-- ─── SEPARATE CONTENT: Flanking Heritage (Left) & AI Future (Right) ─── -->
    <div class="about-split-content">
        <!-- 1. LEFT CARD: 1976 Heritage -->
        <div class="about-heritage-card">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-warning text-dark fw-bold px-2 py-1" style="font-size: 0.72rem;">EST. 1976</span>
                <span class="text-uppercase fw-semibold text-warning tracking-wider" style="font-size: 0.75rem; letter-spacing: 1px;">Half-Century Heritage</span>
            </div>
            <h2 class="h4 fw-bold text-white mb-2">Maritime Mastery</h2>
            <p class="small text-white-50 mb-3" style="line-height: 1.55;">
                Founded on the historic maritime corridors of Dubai Creek, LOTKA has delivered five decades of unwavering freight dependability and deep port authority trust across the Arabian Gulf and global trade routes.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <span class="badge bg-dark border border-secondary border-opacity-50 text-white-50 small py-1 px-2">
                    <i class="fa-solid fa-anchor text-warning me-1"></i> 50 Years Proven
                </span>
                <span class="badge bg-dark border border-secondary border-opacity-50 text-white-50 small py-1 px-2">
                    <i class="fa-solid fa-file-shield text-warning me-1"></i> Licensed Customs
                </span>
            </div>
        </div>

        <!-- 2. RIGHT CARD: Autonomous AI Future -->
        <div class="about-ai-card">
            <div class="d-flex align-items-center justify-content-end gap-2 mb-2">
                <span class="text-uppercase fw-semibold text-info tracking-wider" style="font-size: 0.75rem; letter-spacing: 1px;">Cognitive Logistics</span>
                <span class="badge bg-info text-dark fw-bold px-2 py-1" style="font-size: 0.72rem;">2026+ ERA</span>
            </div>
            <h2 class="h4 fw-bold text-white mb-2">Autonomous Frontier</h2>
            <p class="small text-white-50 mb-3" style="line-height: 1.55;">
                From Dubai JAFZA One, our cognitive neural network dynamically plans shipping routes, predicts fuel and port congestion variables, and automates digital customs clearance with sub-second precision.
            </p>
            <div class="d-flex flex-wrap justify-content-end gap-2">
                <span class="badge bg-dark border border-secondary border-opacity-50 text-white-50 small py-1 px-2">
                    <i class="fa-solid fa-microchip text-info me-1"></i> Neural Dispatch
                </span>
                <span class="badge bg-dark border border-secondary border-opacity-50 text-white-50 small py-1 px-2">
                    <i class="fa-solid fa-satellite text-info me-1"></i> Satellite Telemetry
                </span>
            </div>
        </div>
    </div>

    <!-- ── Center Bottom Trigger: Full Milestones Modal ── -->
    <div class="about-center-action">
        <button type="button" 
                class="btn btn-outline-light rounded-pill px-4 py-2 fw-semibold shadow-lg d-inline-flex align-items-center gap-2"
                style="background: rgba(10, 24, 52, 0.85); backdrop-filter: blur(14px); border-color: rgba(255,255,255,0.25);"
                data-bs-toggle="modal" 
                data-bs-target="#aboutMilestonesModal">
            <i class="fa-solid fa-timeline text-warning"></i>
            <span>50-Year Milestones Timeline (1976 – 2026)</span>
        </button>
    </div>
</section>

<!-- ══════════════════════════════════════════════════════════════
     MODAL: 50-YEAR HERITAGE TO AUTONOMOUS TIMELINE
     ══════════════════════════════════════════════════════════════ -->
<div class="modal fade lotka-modal" id="aboutMilestonesModal" tabindex="-1" aria-labelledby="aboutModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content border-secondary border-opacity-25 shadow-2xl">
            <!-- Modal Header -->
            <div class="modal-header border-bottom border-secondary border-opacity-25 pb-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning text-dark fw-bold px-2 py-1">1976 &rarr; 2026</span>
                    <h5 class="modal-title fw-bold text-white mb-0" id="aboutModalTitle">
                        The LOTKA Journey: Half a Century of Progress
                    </h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body p-3 p-md-4">
                <div class="timeline-container">
                    <!-- 1976 -->
                    <div class="d-flex gap-3 mb-4">
                        <div class="text-warning fw-bold fs-5 text-nowrap" style="min-width: 60px;">1976</div>
                        <div class="border-start border-warning border-2 ps-3">
                            <h6 class="text-white fw-bold mb-1">Dubai Creek Maritime Agency</h6>
                            <p class="text-white-50 small mb-0">
                                Established in Deira Dubai as a dedicated shipping agent and customs clearing house serving regional Arabian Gulf dhow and breakbulk trade.
                            </p>
                        </div>
                    </div>

                    <!-- 1992 -->
                    <div class="d-flex gap-3 mb-4">
                        <div class="text-warning fw-bold fs-5 text-nowrap" style="min-width: 60px;">1992</div>
                        <div class="border-start border-secondary border-2 ps-3">
                            <h6 class="text-white fw-bold mb-1">Jebel Ali Port (JAFZA) Expansion</h6>
                            <p class="text-white-50 small mb-0">
                                Expanded containerized liner agency operations into JAFZA, becoming an early pioneer of freezone transshipment and bonded warehousing.
                            </p>
                        </div>
                    </div>

                    <!-- 2008 -->
                    <div class="d-flex gap-3 mb-4">
                        <div class="text-info fw-bold fs-5 text-nowrap" style="min-width: 60px;">2008</div>
                        <div class="border-start border-secondary border-2 ps-3">
                            <h6 class="text-white fw-bold mb-1">Global Multimodal Network</h6>
                            <p class="text-white-50 small mb-0">
                                Integrated direct air freight corridors via Dubai Airport Cargo Village and sea-air transfer facilities connecting Europe, Asia, and the Americas.
                            </p>
                        </div>
                    </div>

                    <!-- 2021 -->
                    <div class="d-flex gap-3 mb-4">
                        <div class="text-info fw-bold fs-5 text-nowrap" style="min-width: 60px;">2021</div>
                        <div class="border-start border-secondary border-2 ps-3">
                            <h6 class="text-white fw-bold mb-1">AI Predictive Freight Engine Launch</h6>
                            <p class="text-white-50 small mb-0">
                                Deployed our first neural machine learning model to predict ocean freight spot rates, bunker price swings, and container dwell times.
                            </p>
                        </div>
                    </div>

                    <!-- 2026 -->
                    <div class="d-flex gap-3">
                        <div class="text-danger fw-bold fs-5 text-nowrap" style="min-width: 60px;">2026</div>
                        <div class="border-start border-danger border-2 ps-3">
                            <h6 class="text-white fw-bold mb-1">Autonomous Neural Freight & People Synergy</h6>
                            <p class="text-white-50 small mb-0">
                                Today, LOTKA represents the pinnacle of <em>People + AI</em>: 50 years of human shipping stewardship coupled with autonomous satellite cargo telemetry from JAFZA One.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer border-top border-secondary border-opacity-25 d-flex justify-content-between">
                <span class="text-white-50 small"><i class="fa-solid fa-location-dot text-danger me-1"></i> JAFZA One, Office FZJOBB1906, Dubai, UAE</span>
                <button type="button" class="btn btn-lotka-red btn-sm px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
