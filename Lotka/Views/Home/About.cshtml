@{
    ViewData["Title"] = "About Us | Heritage (1976) & Autonomous Future";
}

<!-- ─── HERO: Full-width about-heritage-future image with text over it ─── -->
<section class="lotka-fullwidth-hero">
    <div class="fullwidth-image-wrapper">
        <img src="~/images/about-heritage-future.jpg"
             alt="LOTKA Logistics Heritage 1976 to AI Era" class="fullwidth-hero-img" />
        <div class="fullwidth-hero-overlay-about"></div>
    </div>

    <div class="container-fluid px-4 px-lg-5 hero-content-overlay">
        <div class="min-vh-hero w-100">
            <div class="col-xl-6 col-lg-7 col-md-10 text-white px-0">
                <div class="hero-eyebrow-tag mb-3">
                    <span class="eyebrow-accent-bar"></span>
                    <span class="eyebrow-caption">EST. 1976 &bull; JAFZA ONE, DUBAI</span>
                </div>
                <h1 class="hero-main-title display-4 fw-bold mb-3">
                    Our Heritage &amp; Autonomous Future
                </h1>
                <div class="p-4 rounded-4 glass-panel mb-4">
                    <p class="lead fs-6 mb-2 text-white">
                        Founded in 1976 during the birth of Arabian Gulf maritime commerce, LOTKA mastered port stevedoring, breakbulk cargo, and cross-border logistics when every shipping manifest was handwritten.
                    </p>
                    <p class="small mb-0 text-white-50">
                        Today, 50 years of shipping diplomacy and port authority relationships are fused with our cognitive AI engine — predicting sea-lane bottlenecks, automating customs in AED, and tracking live IoT telemetry across 140+ countries in real time.
                    </p>
                </div>
                <div class="d-flex flex-wrap gap-3">
                    <a href="/Home/Services" class="btn btn-lotka-red px-4 py-2 fw-semibold spa-link" data-page="Services">
                        Explore Our Services &rarr;
                    </a>
                    <a href="/Home/WhyLotka" class="btn btn-outline-light px-4 py-2 fw-semibold spa-link" data-page="WhyLotka">
                        Why Choose LOTKA
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
