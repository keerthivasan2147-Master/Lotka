@{
    ViewData["Title"] = "About Us | Built on Experience. Driven by Innovation.";
}

<!-- ─── HERO: Full-Width About Us — Zoomed-out uncropped hero with timeline ─── -->
<section class="lotka-about-hero-section position-relative">
    <div class="about-hero-container">
        <!-- Background Image: Scaled to fit without vertical crop -->
        <img src="~/images/about-hero.png"
             alt="LOTKA – Built on Experience. Driven by Innovation."
             class="about-hero-img" />

        <!-- Separate Content: Title floating at the top center of the image sky -->
        <div class="about-title-overlay">
            <h2>Built on Experience. <span class="text-accent">Driven by Innovation.</span></h2>
            <div class="about-subtitle">Connecting Today&rsquo;s Opportunities to a Better Tomorrow.</div>
            <div class="about-subtitle-bar"></div>
        </div>
    </div>

    <!-- SEO -->
    <h1 class="visually-hidden">Built on Experience. Driven by Innovation. Connecting today's opportunities to a better tomorrow.</h1>
</section>

