@{
    ViewData["Title"] = "About Us | Heritage (1976) & Autonomous Future";
}

<!-- ─── HERO: Full-width about-heritage-future image with text over it ─── -->
<section class="lotka-fullwidth-hero">
    <div class="fullwidth-image-wrapper">
        <img src="~/images/about-heritage-future.jpg"
             alt="LOTKA Logistics Heritage 1976 to AI Era" class="fullwidth-hero-img" />
        <div class="fullwidth-hero-overlay-about"></div>
    </div>

    <div class="container-fluid px-4 px-lg-5 hero-content-overlay">
        <div class="min-vh-hero w-100">
            <div class="col-xl-6 col-lg-7 col-md-10 text-white px-0">
                <div class="hero-eyebrow-tag mb-3">
                    <span class="eyebrow-accent-bar"></span>
                    <span class="eyebrow-caption">EST. 1976 &bull; JAFZA ONE, DUBAI</span>
                </div>
                <h1 class="hero-main-title display-4 fw-bold mb-3">
                    Our Heritage &amp; Autonomous Future
                </h1>
                <div class="p-4 rounded-4 glass-panel mb-4">
                    <p class="lead fs-6 mb-2 text-white">
                        Founded in 1976 during the birth of Arabian Gulf maritime commerce, LOTKA mastered port stevedoring, breakbulk cargo, and cross-border logistics when every shipping manifest was handwritten.
                    </p>
                    <p class="small mb-0 text-white-50">
                        Today, 50 years of shipping diplomacy and port authority relationships are fused with our cognitive AI engine — predicting sea-lane bottlenecks, automating customs in AED, and tracking live IoT telemetry across 140+ countries in real time.
                    </p>
                </div>
                <div class="d-flex flex-wrap gap-3">
                    <a href="/Home/Services" class="btn btn-lotka-red px-4 py-2 fw-semibold spa-link" data-page="Services">
                        Explore Our Services &rarr;
                    </a>
                    <a href="/Home/WhyLotka" class="btn btn-outline-light px-4 py-2 fw-semibold spa-link" data-page="WhyLotka">
                        Why Choose LOTKA
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ─── 3-Era Evolution Cards ─── -->
<section class="py-5 bg-navy-alt border-top border-bottom border-secondary border-opacity-25">
    <div class="container-fluid px-4 px-lg-5">
        <div class="row g-4 text-white">
            <div class="col-lg-4">
                <div class="lotka-card p-4 rounded-4 h-100">
                    <div class="text-warning fs-2 mb-2"><i class="fa-solid fa-anchor"></i></div>
                    <h3 class="h4 fw-bold mb-2">1976 — Physical Roots</h3>
                    <p class="text-white-50 small mb-0">
                        Breakbulk freighters, timber crates, and dockside cranes. We built trust through direct carrier handshakes, meticulous port execution, and hand-stamped bills of lading across the Gulf.
                    </p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="lotka-card p-4 rounded-4 h-100">
                    <div class="text-primary fs-2 mb-2"><i class="fa-solid fa-boxes-stacked"></i></div>
                    <h3 class="h4 fw-bold mb-2">2000s — Multimodal Scale</h3>
                    <p class="text-white-50 small mb-0">
                        Pioneered sea-air bonded connectivity from Jebel Ali Port to Dubai International. Expanded FCL and LCL scheduled networks across Europe, Asia, and the Americas.
                    </p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="lotka-card p-4 rounded-4 h-100">
                    <div class="text-danger fs-2 mb-2"><i class="fa-solid fa-brain"></i></div>
                    <h3 class="h4 fw-bold mb-2">2026 — The Cognitive Era</h3>
                    <p class="text-white-50 small mb-0">
                        Human master operators amplified by high-speed neural models. Automated HS tariff classification, sub-15-second AED quotes, satellite IoT tracking, and predictive delay rerouting.
                    </p>
                </div>
            </div>
        </div>

        <!-- Global Hubs -->
        <div class="row g-4 text-white mt-2">
            <div class="col-12 text-center mb-2">
                <h2 class="display-6 fw-bold">Strategic Global Hubs</h2>
                <p class="text-white-50">Anchored in Dubai with maritime and aviation nodes across four continents.</p>
            </div>
            <div class="col-lg-3 col-sm-6">
                <div class="p-3 rounded-4 bg-dark border border-secondary text-center h-100">
                    <div class="fs-1 mb-1">🇦🇪</div>
                    <h5 class="fw-bold mb-1">Dubai HQ</h5>
                    <p class="text-white-50 small mb-1">JAFZA One, Jebel Ali Freezone</p>
                    <span class="badge bg-danger">Central Command</span>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6">
                <div class="p-3 rounded-4 bg-dark border border-secondary text-center h-100">
                    <div class="fs-1 mb-1">🇳🇱</div>
                    <h5 class="fw-bold mb-1">Rotterdam</h5>
                    <p class="text-white-50 small mb-1">Port of Rotterdam Gateway</p>
                    <span class="badge bg-primary">European Hub</span>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6">
                <div class="p-3 rounded-4 bg-dark border border-secondary text-center h-100">
                    <div class="fs-1 mb-1">🇸🇬</div>
                    <h5 class="fw-bold mb-1">Singapore</h5>
                    <p class="text-white-50 small mb-1">Jurong &amp; Changi Transshipment</p>
                    <span class="badge bg-info">Asia-Pacific</span>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6">
                <div class="p-3 rounded-4 bg-dark border border-secondary text-center h-100">
                    <div class="fs-1 mb-1">🇺🇸</div>
                    <h5 class="fw-bold mb-1">Houston</h5>
                    <p class="text-white-50 small mb-1">Port of Houston &amp; IAH Air Hub</p>
                    <span class="badge bg-warning text-dark">Americas</span>
                </div>
            </div>
        </div>
    </div>
</section>
