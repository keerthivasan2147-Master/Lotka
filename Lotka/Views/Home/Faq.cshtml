@{
    ViewData["Title"] = "FAQ | Questions on Freight, Tracking & AED Quotes";
}


<!-- ─── HERO: Full-Width AI Desk Banner for FAQ (image 4) ─── -->
<section class="lotka-fullwidth-hero lotka-faq-hero">
    <div class="fullwidth-image-wrapper">
        <img src="~/images/faq-hero.png"
             alt="LOTKA FAQ – Smarter Questions, Brighter Answers"
             class="faq-hero-img" />
    </div>

    <!-- Visually hidden heading for SEO & Accessibility -->
    <h1 class="visually-hidden">Frequently Asked Questions – Smarter Questions, Brighter Answers</h1>
</section>

<!-- ─── FAQ Interactive Accordion Section ─── -->
<section class="py-5 bg-navy-alt">
    <div class="container">
        <!-- Breadcrumbs & Category Intro -->
        <div class="text-center max-w-700 mx-auto mb-4">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb justify-content-center text-white-50 small mb-2">
                    <li class="breadcrumb-item"><a href="/Home/Index" class="text-white-50 text-decoration-none spa-link" data-page="Index">Home</a></li>
                    <li class="breadcrumb-item active text-white" aria-current="page">FAQ</li>
                </ol>
            </nav>
            <div class="hero-eyebrow-tag justify-content-center mb-2">
                <span class="eyebrow-accent-bar"></span>
                <span class="eyebrow-caption">FREIGHT KNOWLEDGE BASE &bull; AED RATES</span>
                <span class="eyebrow-accent-bar"></span>
            </div>
            <p class="lead text-white-50 fs-6 mb-0">
                Transparent answers on freight rates in AED, IoT tracking telemetry, Dubai customs clearance, and how our AI dispatch system works.
            </p>
        </div>

        <!-- Search filter -->
        <div class="max-w-700 mx-auto mb-5">
            <div class="input-group input-group-lg shadow-sm">
                <span class="input-group-text bg-dark border-secondary text-white-50"><i class="fa-solid fa-search"></i></span>
                <input type="text" id="faqSearchInput" class="form-control bg-dark text-white border-secondary"
                       placeholder="Filter questions (e.g. JAFZA, customs, AED, tracking)..." />
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="accordion lotka-accordion" id="faqAccordion">

                    <!-- Q1 -->
                    <div class="accordion-item bg-dark border-secondary mb-3 rounded-3 overflow-hidden">
                        <h2 class="accordion-header" id="headingOne">
                            <button class="accordion-button bg-dark text-white fw-semibold" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true">
                                <i class="fa-solid fa-calculator text-danger me-3"></i>
                                How does LOTKA calculate instant freight quotes in AED under 15 seconds?
                            </button>
                        </h2>
                        <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-white-50 small">
                                Our cognitive pricing engine connects via authenticated EDI and API protocols with major ocean carriers (Maersk, MSC, CMA CGM, Hapag-Lloyd) and international air carriers. The system simultaneously checks spot market indices, terminal handling fees, current bunker fuel adjustments, and Dubai JAFZA port schedules to provide guaranteed binding rates in AED in real time — no manual intervention needed.
                            </div>
                        </div>
                    </div>

                    <!-- Q2 -->
                    <div class="accordion-item bg-dark border-secondary mb-3 rounded-3 overflow-hidden">
                        <h2 class="accordion-header" id="headingTwo">
                            <button class="accordion-button collapsed bg-dark text-white fw-semibold" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#collapseTwo">
                                <i class="fa-solid fa-satellite text-info me-3"></i>
                                How does real-time IoT tracking differ from standard carrier tracking?
                            </button>
                        </h2>
                        <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-white-50 small">
                                Conventional carriers only report cargo status when a barcode is manually scanned at ports or checkpoints. LOTKA integrates hardware IoT container sensors that communicate continuously via low-earth orbit satellite constellations. You receive live telemetry of container GPS coordinates, internal temperature, humidity, and electronic seal integrity — 24/7, from Dubai JAFZA to your final destination.
                            </div>
                        </div>
                    </div>

                    <!-- Q3 -->
                    <div class="accordion-item bg-dark border-secondary mb-3 rounded-3 overflow-hidden">
                        <h2 class="accordion-header" id="headingThree">
                            <button class="accordion-button collapsed bg-dark text-white fw-semibold" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#collapseThree">
                                <i class="fa-solid fa-building-flag text-warning me-3"></i>
                                What advantages does shipping through Dubai JAFZA Freezone provide?
                            </button>
                        </h2>
                        <div id="collapseThree" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-white-50 small">
                                JAFZA (Jebel Ali Free Zone) is the Middle East's primary trade hub. Goods imported into JAFZA for consolidation, processing, or regional re-export are exempt from UAE customs duty (0% tariffs). Sea-to-air multimodal transfers between Jebel Ali Port and Al Maktoum International Airport (DWC) take under 6 hours via dedicated customs bonded corridors. All LOTKA invoicing is in AED with no currency conversion risk.
                            </div>
                        </div>
                    </div>

                    <!-- Q4 -->
                    <div class="accordion-item bg-dark border-secondary mb-3 rounded-3 overflow-hidden">
                        <h2 class="accordion-header" id="headingFour">
                            <button class="accordion-button collapsed bg-dark text-white fw-semibold" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#collapseFour">
                                <i class="fa-solid fa-file-shield text-success me-3"></i>
                                How does automated HS Code verification reduce customs delays?
                            </button>
                        </h2>
                        <div id="collapseFour" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-white-50 small">
                                Incorrect Harmonized System (HS) tariff classification is the #1 reason international shipments get held or penalized at borders. Our natural language and computer vision models audit commercial invoices and packing lists to identify correct 6-digit to 10-digit HS codes with 99.9% accuracy before electronic submission to Dubai Customs or overseas authorities — saving AED in avoidable penalty fees.
                            </div>
                        </div>
                    </div>

                    <!-- Q5 -->
                    <div class="accordion-item bg-dark border-secondary mb-3 rounded-3 overflow-hidden">
                        <h2 class="accordion-header" id="headingFive">
                            <button class="accordion-button collapsed bg-dark text-white fw-semibold" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#collapseFive">
                                <i class="fa-solid fa-users text-primary me-3"></i>
                                Does AI replace human freight coordinators at LOTKA?
                            </button>
                        </h2>
                        <div id="collapseFive" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-white-50 small">
                                Never. Our philosophy is <strong class="text-white">People + AI</strong>. AI automates monotonous tasks like repetitive rate extraction, schedule comparisons, and data auditing. This frees our human logistics specialists to concentrate on what machines cannot do: negotiating vessel space during peak seasons, managing customized supply chain projects, and providing personal care to every Dubai JAFZA shipper.
                            </div>
                        </div>
                    </div>

                    <!-- Q6 -->
                    <div class="accordion-item bg-dark border-secondary mb-3 rounded-3 overflow-hidden">
                        <h2 class="accordion-header" id="headingSix">
                            <button class="accordion-button collapsed bg-dark text-white fw-semibold" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#collapseSix">
                                <i class="fa-solid fa-shield-virus text-danger me-3"></i>
                                Is corporate shipment data and proprietary AED pricing protected?
                            </button>
                        </h2>
                        <div id="collapseSix" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-white-50 small">
                                Absolutely. LOTKA operates under strict enterprise security protocols with ISO 27001 certified data pipelines and end-to-end TLS 1.3 encryption. Commercial client AED rates, bill of lading invoices, and cargo specifications are never shared or used to train public algorithms.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- CTA panel -->
                <div class="text-center p-4 rounded-4 mt-5 bg-dark border border-secondary text-white">
                    <h4 class="fw-bold mb-2">Have a question not covered here?</h4>
                    <p class="text-white-50 small mb-3">Our Dubai JAFZA operations team and AI advisors are ready to assist with AED rates, custom cargo, or multimodal requirements.</p>
                    <div class="d-flex gap-3 justify-content-center flex-wrap">
                        <a href="/Home/Contact" class="btn btn-lotka-red px-4 spa-link" data-page="Contact">
                            Contact JAFZA Dubai Office &rarr;
                        </a>
                        <a href="/Home/Quote" class="btn btn-outline-light px-4 spa-link" data-page="Quote">
                            Get AED Quote Now
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
