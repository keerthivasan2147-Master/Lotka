@{
    ViewData["Title"] = "Logistics Services | Ocean, Air & Smart Multimodal";
}

<!-- ─── HERO: Full-width services-showcase image (Picture Way) ─── -->
<section class="lotka-fullwidth-hero lotka-services-hero position-relative">
    <div class="fullwidth-image-wrapper">
        <img src="~/images/services-hero.png"
             alt="LOTKA Ocean and Air Freight – Moving a Smarter Tomorrow"
             class="fullwidth-hero-img services-hero-img" />
    </div>

    <!-- Services Header (Only for Phone, aligned like Left Service Display with About Us Header Font size) -->
    <div class="services-title-overlay about-title-overlay d-block d-md-none">
        <div class="about-subtitle services-phone-header">OCEAN &amp; AIR FREIGHT SOLUTIONS</div>
        <div class="about-subtitle-bar services-phone-bar"></div>
    </div>

    <h1 class="visually-hidden">LOTKA Multimodal Logistics – Ocean and Air Freight Services from Dubai</h1>
</section>
