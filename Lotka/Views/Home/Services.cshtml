@{
    ViewData["Title"] = "Logistics Services | Ocean, Air & Smart Multimodal";
}

<!-- ─── HERO: Full-width services-showcase image with text over it ─── -->
<section class="lotka-fullwidth-hero">
    <div class="fullwidth-image-wrapper">
        <img src="~/images/services-showcase.jpg"
             alt="LOTKA Ocean and Air Freight – Moving a Smarter Tomorrow"
             class="fullwidth-hero-img" />
        <div class="fullwidth-services-overlay"></div>
    </div>

    <div class="container-fluid px-4 px-lg-5 hero-content-overlay">
        <div class="min-vh-hero w-100 d-flex align-items-flex-end">
            <!-- Bottom-left panel over the image -->
            <div class="col-xl-10 col-12 text-white px-0 mt-auto pb-4">
                <div class="hero-eyebrow-tag mb-3">
                    <span class="eyebrow-accent-bar"></span>
                    <span class="eyebrow-caption">MOVING A SMARTER TOMORROW</span>
                </div>
                <h1 class="hero-main-title display-4 fw-bold mb-3">Multimodal Logistics Solutions</h1>
                <div class="row g-4">
                    <!-- Ocean Freight Card over image -->
                    <div class="col-lg-5 col-md-6">
                        <div class="p-4 rounded-4 glass-panel h-100">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="fa-solid fa-ship text-primary fs-4"></i>
                                <span class="fw-bold text-primary text-uppercase small">OCEAN FREIGHT</span>
                            </div>
                            <h2 class="h4 fw-bold text-white mb-2">Reliable Routes &bull; A Wider World</h2>
                            <p class="text-white-50 small mb-3">
                                FCL and LCL container allocations departing Jebel Ali Port weekly. Priority berth boarding with live AED pricing — no hidden destination surcharges.
                            </p>
                            <a href="/Home/Quote" class="btn btn-outline-light btn-sm px-3 spa-link" data-page="Quote">
                                Get AED Ocean Rate &rarr;
                            </a>
                        </div>
                    </div>
                    <!-- Air Freight Card over image -->
                    <div class="col-lg-5 col-md-6">
                        <div class="p-4 rounded-4 glass-panel h-100">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="fa-solid fa-plane-departure text-warning fs-4"></i>
                                <span class="fw-bold text-warning text-uppercase small">AIR FREIGHT</span>
                            </div>
                            <h2 class="h4 fw-bold text-white mb-2">Higher Speed &bull; Greater Possibilities</h2>
                            <p class="text-white-50 small mb-3">
                                Next-flight-out express, full aircraft charters, and pharma cold chain via DXB and DWC. Door-to-door AED rates in under 15 seconds.
                            </p>
                            <a href="/Home/Quote" class="btn btn-outline-light btn-sm px-3 spa-link" data-page="Quote">
                                Get AED Air Rate &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ─── Additional Services Cards ─── -->
<section class="py-5 bg-navy-alt">
    <div class="container-fluid px-4 px-lg-5">
        <div class="text-center mb-5">
            <span class="badge bg-danger bg-opacity-25 text-danger px-3 py-2 rounded-pill fw-bold text-uppercase mb-2">Full Service Suite</span>
            <h2 class="display-6 fw-bold text-white">All Modes. One Intelligent Platform.</h2>
        </div>
        <div class="row g-4 text-white">
            <div class="col-lg-4 col-md-6">
                <div class="lotka-card p-4 rounded-4 h-100">
                    <div class="text-success fs-2 mb-2"><i class="fa-solid fa-truck-fast"></i></div>
                    <h3 class="h5 fw-bold mb-2">Land &amp; GCC Cross-Border</h3>
                    <p class="text-white-50 small mb-3">Direct bonded trailer convoys across Saudi Arabia, Oman, Kuwait, Qatar, and Bahrain with electronic customs seals and AED invoicing.</p>
                    <a href="/Home/Quote" class="btn btn-outline-light btn-sm spa-link" data-page="Quote">Get AED Rate</a>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="lotka-card p-4 rounded-4 h-100">
                    <div class="text-danger fs-2 mb-2"><i class="fa-solid fa-warehouse"></i></div>
                    <h3 class="h5 fw-bold mb-2">JAFZA Bonded Warehousing</h3>
                    <p class="text-white-50 small mb-3">Zero customs duty on transit storage. Automated WMS, pick-pack-kitting, temperature control, and swift re-export dispatch from Dubai Freezone.</p>
                    <a href="/Home/Contact" class="btn btn-outline-light btn-sm spa-link" data-page="Contact">Enquire on Space</a>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="lotka-card p-4 rounded-4 h-100">
                    <div class="text-info fs-2 mb-2"><i class="fa-solid fa-file-contract"></i></div>
                    <h3 class="h5 fw-bold mb-2">Automated Customs Clearance</h3>
                    <p class="text-white-50 small mb-3">Instant Mirsal 2 filing with AI HS code validation. 99.9% clean border clearance, automated AED duty calculation, and zero hold penalties.</p>
                    <a href="/Home/Contact" class="btn btn-outline-light btn-sm spa-link" data-page="Contact">Consult Our Team</a>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="lotka-card p-4 rounded-4 h-100">
                    <div class="text-primary fs-2 mb-2"><i class="fa-solid fa-network-wired"></i></div>
                    <h3 class="h5 fw-bold mb-2">AI Dynamic Routing Engine</h3>
                    <p class="text-white-50 small mb-3">Millions of maritime routes, live weather overlays, port congestion alerts, and carrier rate arbitrage computed in real time. Predictive 72-hour delay warnings included.</p>
                    <a href="/Home/WhyLotka" class="btn btn-outline-light btn-sm spa-link" data-page="WhyLotka">How It Works</a>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="lotka-card p-4 rounded-4 h-100">
                    <div class="text-warning fs-2 mb-2"><i class="fa-solid fa-satellite"></i></div>
                    <h3 class="h5 fw-bold mb-2">IoT Live Cargo Tracking</h3>
                    <p class="text-white-50 small mb-3">Low-earth satellite sensors broadcast GPS, temperature, humidity, and electronic seal integrity on every container or air pallet — 24/7, no manual check-ins needed.</p>
                    <a href="/Home/Benefits" class="btn btn-outline-light btn-sm spa-link" data-page="Benefits">View Benefits</a>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="lotka-card p-4 rounded-4 h-100">
                    <div class="text-success fs-2 mb-2"><i class="fa-solid fa-refrigerator"></i></div>
                    <h3 class="h5 fw-bold mb-2">Cold Chain &amp; Pharma Handling</h3>
                    <p class="text-white-50 small mb-3">GDP-compliant pharmaceutical logistics with real-time temperature logging between -20°C to +25°C. Dedicated pharma reefer fleet and digital excursion reports in AED.</p>
                    <a href="/Home/Contact" class="btn btn-outline-light btn-sm spa-link" data-page="Contact">Discuss Requirements</a>
                </div>
            </div>
        </div>
    </div>
</section>
