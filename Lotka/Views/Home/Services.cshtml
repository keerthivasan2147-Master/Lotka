@{
    ViewData["Title"] = "Logistics Services | Ocean, Air & Smart Multimodal";
}

<!-- ─── HERO: Full-width services-showcase image with text over it ─── -->
<section class="lotka-fullwidth-hero">
    <div class="fullwidth-image-wrapper">
        <img src="~/images/services-showcase.jpg"
             alt="LOTKA Ocean and Air Freight – Moving a Smarter Tomorrow"
             class="fullwidth-hero-img" />
        <div class="fullwidth-services-overlay"></div>
    </div>

    <div class="container-fluid px-4 px-lg-5 hero-content-overlay">
        <div class="min-vh-hero w-100 d-flex align-items-flex-end">
            <!-- Bottom-left panel over the image -->
            <div class="col-xl-10 col-12 text-white px-0 mt-auto pb-4">
                <div class="hero-eyebrow-tag mb-3">
                    <span class="eyebrow-accent-bar"></span>
                    <span class="eyebrow-caption">MOVING A SMARTER TOMORROW</span>
                </div>
                <h1 class="hero-main-title display-4 fw-bold mb-3">Multimodal Logistics Solutions</h1>
                <div class="row g-4">
                    <!-- Ocean Freight Card over image -->
                    <div class="col-lg-5 col-md-6">
                        <div class="p-4 rounded-4 glass-panel h-100">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="fa-solid fa-ship text-primary fs-4"></i>
                                <span class="fw-bold text-primary text-uppercase small">OCEAN FREIGHT</span>
                            </div>
                            <h2 class="h4 fw-bold text-white mb-2">Reliable Routes &bull; A Wider World</h2>
                            <p class="text-white-50 small mb-3">
                                FCL and LCL container allocations departing Jebel Ali Port weekly. Priority berth boarding with live AED pricing — no hidden destination surcharges.
                            </p>
                            <a href="/Home/Quote" class="btn btn-outline-light btn-sm px-3 spa-link" data-page="Quote">
                                Get AED Ocean Rate &rarr;
                            </a>
                        </div>
                    </div>
                    <!-- Air Freight Card over image -->
                    <div class="col-lg-5 col-md-6">
                        <div class="p-4 rounded-4 glass-panel h-100">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="fa-solid fa-plane-departure text-warning fs-4"></i>
                                <span class="fw-bold text-warning text-uppercase small">AIR FREIGHT</span>
                            </div>
                            <h2 class="h4 fw-bold text-white mb-2">Higher Speed &bull; Greater Possibilities</h2>
                            <p class="text-white-50 small mb-3">
                                Next-flight-out express, full aircraft charters, and pharma cold chain via DXB and DWC. Door-to-door AED rates in under 15 seconds.
                            </p>
                            <a href="/Home/Quote" class="btn btn-outline-light btn-sm px-3 spa-link" data-page="Quote">
                                Get AED Air Rate &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


