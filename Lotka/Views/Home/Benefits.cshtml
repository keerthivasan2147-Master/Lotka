}

<!-- ─── HERO: Full-Width Human + AI Synergy (Image 2) ─── -->
<section class="lotka-fullwidth-hero">
    <div class="fullwidth-image-wrapper">
        <img src="~/images/Benefits.png"
             alt="LOTKA Human Mastery and AI Synergy"
             class="fullwidth-hero-img" />
        <div class="fullwidth-benefits-overlay"></div>
    </div>

    <div class="container-fluid px-4 px-lg-5 hero-content-overlay">
        <div class="min-vh-hero w-100">
            <div class="col-xl-6 col-lg-7 col-md-10 text-white px-0">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb text-white-50 small mb-2">
                        <li class="breadcrumb-item"><a href="/Home/Index" class="text-white-50 text-decoration-none spa-link" data-page="Index">Home</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Benefits</li>
