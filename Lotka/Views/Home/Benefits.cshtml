@{
    ViewData["Title"] = "Benefits | Faster Quotes, Greater Transparency & Zero Errors";
}

<!-- ─── HERO: Full-Width Human + AI Synergy (Image 2) ─── -->
<section class="lotka-fullwidth-hero">
    <div class="fullwidth-image-wrapper">
        <img src="~/images/human-ai-benefits.jpg"
             alt="LOTKA Human Mastery and AI Synergy"
             class="fullwidth-hero-img" />
        <div class="fullwidth-benefits-overlay"></div>
    </div>

    <div class="container-fluid px-4 px-lg-5 hero-content-overlay">
        <div class="min-vh-hero w-100">
            <div class="col-xl-6 col-lg-7 col-md-10 text-white px-0">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb text-white-50 small mb-2">
                        <li class="breadcrumb-item"><a href="/Home/Index" class="text-white-50 text-decoration-none spa-link" data-page="Index">Home</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Benefits</li>
                    </ol>
                </nav>
                <div class="hero-eyebrow-tag mb-3">
                    <span class="eyebrow-accent-bar"></span>
                    <span class="eyebrow-caption">HUMAN MASTERY + AUTONOMOUS AI</span>
                </div>
                <h1 class="hero-main-title display-4 fw-bold mb-3">
                    The Power of Unified Synergy
                </h1>
                <div class="p-4 rounded-4 glass-panel mb-4">
                    <p class="lead fs-6 mb-2 text-white">
                        Combining human logistics diplomacy with autonomous neural systems yields faster quotes in AED, complete price transparency, and zero documentation errors.
                    </p>
                    <p class="small mb-0 text-white-50">
                        Experience sub-15s AI rate estimation, locked-in AED commercial guarantees, and direct Dubai JAFZA port operations oversight 24 hours a day.
                    </p>
                </div>
                <div class="d-flex flex-wrap gap-3">
                    <a href="/Home/Quote" class="btn btn-lotka-red px-4 py-2 fw-semibold spa-link" data-page="Quote">
                        Calculate AED Rate &rarr;
                    </a>
                    <a href="/Home/Services" class="btn btn-outline-light px-4 py-2 fw-semibold spa-link" data-page="Services">
                        Explore Multimodal Fleet
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ─── Core Enterprise Benefits Grid (Strictly AED) ─── -->
<section class="py-5 bg-navy-alt">
    <div class="container-fluid px-4 px-lg-5">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="badge bg-danger bg-opacity-25 text-danger px-3 py-2 rounded-pill text-uppercase fw-bold letter-spacing-1 mb-2">Operational Advantages</span>
            <h2 class="display-6 fw-bold text-white">Built for High-Growth Global Shippers</h2>
            <p class="text-white-50">Eliminating the three greatest pain points in modern shipping: delay, price inflation, and lack of visibility.</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="lotka-card p-4 rounded-4 h-100">
                    <div class="text-info fs-2 mb-3"><i class="fa-solid fa-gauge-high"></i></div>
                    <h3 class="h5 fw-bold text-white mb-2">15-Second Quotes in AED</h3>
                    <p class="text-white-50 small mb-0">
                        Our algorithmic pricing engine pulls live ocean liner carrier capacity, fuel surcharges, and terminal fees to lock commercial AED rates in real time.
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="lotka-card p-4 rounded-4 h-100">
                    <div class="text-success fs-2 mb-3"><i class="fa-solid fa-file-invoice-dollar"></i></div>
                    <h3 class="h5 fw-bold text-white mb-2">Zero Hidden Surcharges</h3>
                    <p class="text-white-50 small mb-0">
                        Every quote is guaranteed all-inclusive in AED. Customs fees, destination terminal handling (THC), and documentation costs are locked at dispatch.
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="lotka-card p-4 rounded-4 h-100">
                    <div class="text-warning fs-2 mb-3"><i class="fa-solid fa-satellite-dish"></i></div>
                    <h3 class="h5 fw-bold text-white mb-2">Real-Time Satellite Telemetry</h3>
                    <p class="text-white-50 small mb-0">
                        Continuous IoT sensors monitor cargo latitude, longitude, temperature, and customs clearance status with predictive arrival alerts.
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="lotka-card p-4 rounded-4 h-100">
                    <div class="text-danger fs-2 mb-3"><i class="fa-solid fa-shield-check"></i></div>
                    <h3 class="h5 fw-bold text-white mb-2">99.9% HS Tariff Accuracy</h3>
                    <p class="text-white-50 small mb-0">
                        Automated AI manifest classification verifies tariff codes against Dubai Customs and destination country regulations, eliminating port clearance hold-ups.
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="lotka-card p-4 rounded-4 h-100">
                    <div class="text-primary fs-2 mb-3"><i class="fa-solid fa-headset"></i></div>
                    <h3 class="h5 fw-bold text-white mb-2">Dedicated Dubai Account Manager</h3>
                    <p class="text-white-50 small mb-0">
                        Every enterprise client is partnered with a veteran logistics coordinator at JAFZA One, backed 24/7 by our autonomous allocation engine.
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="lotka-card p-4 rounded-4 h-100">
                    <div class="text-info fs-2 mb-3"><i class="fa-solid fa-arrows-split-up-and-left"></i></div>
                    <h3 class="h5 fw-bold text-white mb-2">Predictive Route Rerouting</h3>
                    <p class="text-white-50 small mb-0">
                        Weather anomalies, canal congestion, and port strikes are predicted 72 hours ahead with autonomous alternative feeder recommendations.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
