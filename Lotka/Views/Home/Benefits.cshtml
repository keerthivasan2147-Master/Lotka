@{
    ViewData["Title"] = "Benefits | Faster Quotes, Greater Transparency & Zero Errors";
}

<!-- ─── HERO: Full-Width Human + AI Synergy (Picture Way) ─── -->
<section class="lotka-fullwidth-hero position-relative">
    <div class="fullwidth-image-wrapper">
        <img src="~/images/benefits-hero.png"
             alt="LOTKA Human Mastery and AI Synergy"
             class="fullwidth-hero-img" />
    </div>

    <!-- Flanking benefit items left and right of the subjects -->
    <div class="benefits-split-layout">
        <div class="benefit-col">
            <h3 class="benefit-badge">Greater Transparency</h3>
            <h3 class="benefit-badge">Faster Quotes</h3>
            <h3 class="benefit-badge">Fewer Errors</h3>
        </div>
        <div class="benefit-col text-end">
            <h3 class="benefit-badge">Reliable Tracking</h3>
            <h3 class="benefit-badge">Human + AI</h3>
            <h3 class="benefit-badge">24/7 Support</h3>
        </div>
    </div>
</section>
