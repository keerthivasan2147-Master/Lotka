@{
    ViewData["Title"] = "Global Logistics | People + AI Moving Business Forward";
}

<!-- ═══════════════════════════════════════════════════════════
     SECTION 1 — MAIN HERO (Picture Way)
     Image: hero-home-page2.png
     ═══════════════════════════════════════════════════════════ -->
<section class="lotka-fullwidth-hero position-relative">
    <div class="fullwidth-image-wrapper">
        <img src="~/images/hero-home-page2.png"
             alt="LOTKA Logistics – People and AI Moving Business Forward"
             class="fullwidth-hero-img" />
    </div>

    <div class="container-fluid px-3 px-md-4 px-lg-5 hero-content-overlay align-items-center">
        <div class="min-vh-hero w-100">
            <div class="col-xl-6 col-lg-7 col-md-10 text-white px-0 home-hero-content">
                <div class="hero-eyebrow-tag mb-2 mb-md-3">
                    <span class="eyebrow-accent-bar"></span>
                    <span class="eyebrow-caption">GLOBAL LOGISTICS &bull; A BRIGHTER TOMORROW</span>
                </div>
                <h1 class="hero-main-title mb-2 mb-md-3">
                    People <span class="text-accent">+</span> AI<br />
                    Moving Business Forward
                </h1>
                <p class="hero-home-lead mb-3 mb-md-4 pe-lg-5">
                    Smarter collaboration. Faster decisions. A stronger future.
                </p>
                <div class="d-flex flex-wrap gap-2 gap-md-3">
                    <a href="/Home/Quote" class="btn btn-lotka-red btn-home-hero fw-semibold spa-link" data-page="Quote">
                        Get a Quote <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                    <a href="/Home/Services" class="btn btn-outline-light btn-home-hero fw-semibold spa-link" data-page="Services">
                        Our Services <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
