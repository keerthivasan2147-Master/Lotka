@{
    ViewData["Title"] = "Why LOTKA | The Intelligent Logistics Edge";
}

<!-- ─── HERO: Full-Width Planetary Global Network (Image 1) ─── -->
<section class="lotka-fullwidth-hero">
    <div class="fullwidth-image-wrapper">
        <img src="~/images/global-network.png"
             alt="LOTKA Planetary Logistics Network and Multi-modal Fleet"
             class="fullwidth-hero-img" />
        <div class="fullwidth-hero-overlay"></div>
    </div>

    <div class="container-fluid px-4 px-lg-5 hero-content-overlay">
        <div class="min-vh-hero w-100">
            <div class="col-xl-6 col-lg-7 col-md-10 text-white px-0">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb text-white-50 small mb-2">
                        <li class="breadcrumb-item"><a href="/Home/Index" class="text-white-50 text-decoration-none spa-link" data-page="Index">Home</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Why LOTKA</li>
                    </ol>
                </nav>
                <div class="hero-eyebrow-tag mb-3">
                    <span class="eyebrow-accent-bar"></span>
                    <span class="eyebrow-caption">CONTINUOUS PLANETARY COVERAGE</span>
                </div>
                <h1 class="hero-main-title display-4 fw-bold mb-3">
                    Synchronizing Every Flight, Vessel &amp; Truck
                </h1>
                <div class="p-4 rounded-4 glass-panel mb-4">
                    <p class="lead fs-6 mb-2 text-white">
                        From container vessels docking at Jebel Ali Port to long-haul cargo planes in twilight skies, our neural network models every global trade node to prevent bottlenecks before they form.
                    </p>
                    <p class="small mb-0 text-white-50">
                        Serving 140+ countries with locked-in AED commercial tariffs, automated customs clearing, and 24/7 Dubai marine coordination.
                    </p>
                </div>
                <div class="d-flex flex-wrap gap-3">
                    <a href="/Home/Quote" class="btn btn-lotka-red px-4 py-2 fw-semibold spa-link" data-page="Quote">
                        Instant Quote in AED &rarr;
                    </a>
                    <a href="/Home/Services" class="btn btn-outline-light px-4 py-2 fw-semibold spa-link" data-page="Services">
                        Explore Multimodal Routes
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ─── Comparison Matrix: Legacy vs LOTKA (Strictly AED) ─── -->
<section class="py-5 bg-navy-alt">
    <div class="container">
        <div class="text-center max-w-700 mx-auto mb-4">
            <span class="badge bg-danger bg-opacity-25 text-danger px-3 py-2 rounded-pill text-uppercase fw-bold letter-spacing-1 mb-2">Performance Benchmark</span>
            <h2 class="display-6 fw-bold text-white">Outperforming Traditional Shipping</h2>
            <p class="text-white-50">Concrete performance differences between legacy forwarders and LOTKA in Dubai JAFZA.</p>
        </div>

        <div class="table-responsive rounded-4 shadow-lg border border-secondary border-opacity-25">
            <table class="table table-dark table-striped lotka-comparison-table mb-0 align-middle">
                <thead>
                    <tr class="bg-navy-dark">
                        <th class="p-4 fs-6 text-uppercase text-white-50" style="width: 30%;">Operational Dimension</th>
                        <th class="p-4 fs-6 text-uppercase text-danger" style="width: 35%;">Traditional Freight Forwarder</th>
                        <th class="p-4 fs-6 text-uppercase text-info" style="width: 35%;"><i class="fa-solid fa-bolt text-warning me-1"></i> LOTKA Intelligent Shipping</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="p-4 fw-semibold text-white">Quotation Speed</td>
                        <td class="p-4 text-white-50"><i class="fa-solid fa-xmark text-danger me-2"></i> 24 to 72 hours via email threads</td>
                        <td class="p-4 text-white fw-bold"><i class="fa-solid fa-check text-success me-2"></i> Under 15 seconds via AI pricing engine in AED</td>
                    </tr>
                    <tr>
                        <td class="p-4 fw-semibold text-white">Pricing Transparency</td>
                        <td class="p-4 text-white-50"><i class="fa-solid fa-xmark text-danger me-2"></i> Hidden destination terminal & handling fees</td>
                        <td class="p-4 text-white fw-bold"><i class="fa-solid fa-check text-success me-2"></i> Guaranteed all-inclusive locked commercial AED rates</td>
                    </tr>
                    <tr>
                        <td class="p-4 fw-semibold text-white">Cargo Visibility</td>
                        <td class="p-4 text-white-50"><i class="fa-solid fa-xmark text-danger me-2"></i> Fragmented check-in calls with carriers</td>
                        <td class="p-4 text-white fw-bold"><i class="fa-solid fa-check text-success me-2"></i> Live GPS & IoT telemetry with satellite sync</td>
                    </tr>
                    <tr>
                        <td class="p-4 fw-semibold text-white">Documentation Errors</td>
                        <td class="p-4 text-white-50"><i class="fa-solid fa-xmark text-danger me-2"></i> High manual error rate in HS tariff codes</td>
                        <td class="p-4 text-white fw-bold"><i class="fa-solid fa-check text-success me-2"></i> 99.9% automated manifest & customs validation</td>
                    </tr>
                    <tr>
                        <td class="p-4 fw-semibold text-white">Delay Mitigation</td>
                        <td class="p-4 text-white-50"><i class="fa-solid fa-xmark text-danger me-2"></i> Reactive response after cargo is stranded</td>
                        <td class="p-4 text-white fw-bold"><i class="fa-solid fa-check text-success me-2"></i> 72-hour predictive detour recommendations</td>
                    </tr>
                    <tr>
                        <td class="p-4 fw-semibold text-white">Customer Support</td>
                        <td class="p-4 text-white-50"><i class="fa-solid fa-xmark text-danger me-2"></i> Regular office hours only (9 AM - 5 PM)</td>
                        <td class="p-4 text-white fw-bold"><i class="fa-solid fa-check text-success me-2"></i> 24/7 AI resolution + dedicated Dubai human manager</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>
