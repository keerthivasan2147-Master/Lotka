@{
    ViewData["Title"] = "Why LOTKA | The Intelligent Logistics Edge";
}

<!-- ─── HERO: Full-Width Planetary Global Network (Picture Way) ─── -->
<section class="lotka-fullwidth-hero why-hero position-relative">
    <div class="fullwidth-image-wrapper">
        <img src="~/images/why-hero-full.png"
             alt="LOTKA Planetary Logistics Network and Multi-modal Fleet"
             class="fullwidth-hero-img" />
    </div>

    <!-- From Complexity to Clarity text overlay on upper left -->
    <div class="container-fluid px-4 px-lg-5 hero-content-overlay align-items-start pt-5">
        <div class="pt-2 pt-md-4">
            <div class="why-clarity-panel">
                <div class="small text-uppercase fw-semibold mb-2" style="letter-spacing: 1.5px; opacity: 0.9;">Why LOTKA</div>
                <h1 class="display-4 fw-bold mb-3">From Complexity to Clarity.</h1>
                <p class="lead fs-5 mb-2 fw-semibold">Freight forwarding is complex.</p>
                <p class="fs-6" style="opacity: 0.88; line-height: 1.6;">
                    LOTKA brings human expertise and AI-powered operations together to create clearer decisions, faster action, and more reliable execution.
                </p>
            </div>
        </div>
    </div>
</section>
