@model Lotka.Models.QuoteRequestModel
@{
    ViewData["Title"] = "Instant Freight Quote | Real-time AI Estimator (AED)";
}

<!-- ─── HERO: Full-Width Quote Banner ─── -->
<section class="lotka-fullwidth-hero">
    <div class="fullwidth-image-wrapper">
        <img src="~/images/services-showcase.jpg"
             alt="LOTKA Real-Time AI Freight Estimator"
             class="fullwidth-hero-img" style="max-height: 420px;" />
        <div class="fullwidth-services-overlay"></div>
    </div>

    <div class="container-fluid px-4 px-lg-5 hero-content-overlay">
        <div class="min-vh-50 w-100 d-flex align-items-center">
            <div class="col-xl-6 col-lg-7 col-md-9 text-white px-0">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb text-white-50 small mb-2">
                        <li class="breadcrumb-item"><a href="/Home/Index" class="text-white-50 text-decoration-none spa-link" data-page="Index">Home</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Get a Quote</li>
                    </ol>
                </nav>
                <div class="hero-eyebrow-tag mb-2">
                    <span class="eyebrow-accent-bar"></span>
                    <span class="eyebrow-caption">SUB-15s AI RATE ENGINE &bull; ALL RATES IN AED</span>
                </div>
                <h1 class="display-5 fw-bold mb-2">Instant Freight Rate Calculator</h1>
                <p class="lead text-white-50 fs-6 mb-0">
                    Get locked-in commercial rates for Air, Ocean, and Land transport in AED. Guaranteed transparent pricing with zero hidden surcharges from Dubai JAFZA.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- ─── Dedicated Quote Calculator Section (AED) ─── -->
<section class="py-5 bg-navy-alt">
    <div class="container">
        <div class="row g-5">
            <!-- Left: Interactive Form -->
            <div class="col-lg-7">
                <div class="p-4 p-md-5 rounded-4 bg-dark border border-secondary shadow-lg">
                    <h3 class="h4 fw-bold text-white mb-4 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-sliders text-danger"></i> Configure Shipment Parameters
                    </h3>

                    <form id="dedicatedQuoteForm" class="row g-3">
                        <!-- Origin & Destination -->
                        <div class="col-md-6">
                            <label class="form-label text-white small fw-medium">Origin City / Port <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-white-50"><i class="fa-solid fa-location-dot"></i></span>
                                <input type="text" id="quoteOrigin" class="form-control bg-dark text-white border-secondary" placeholder="e.g. Dubai JAFZA" value="Dubai, UAE (JAFZA)" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white small fw-medium">Destination Port / Airport <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-white-50"><i class="fa-solid fa-map-pin"></i></span>
                                <input type="text" id="quoteDestination" class="form-control bg-dark text-white border-secondary" placeholder="e.g. Rotterdam, NL" value="Rotterdam, Netherlands" required />
                            </div>
                        </div>

                        <!-- Transport Mode Selection (Pill Buttons) -->
                        <div class="col-12">
                            <label class="form-label text-white small fw-medium">Select Transport Mode <span class="text-danger">*</span></label>
                            <div class="row g-2" id="quoteModeSelector">
                                <div class="col-4">
                                    <input type="radio" class="btn-check" name="freightType" id="modeAir" value="Air" autocomplete="off" />
                                    <label class="btn btn-outline-secondary w-100 py-3 text-white d-flex flex-column align-items-center gap-1" for="modeAir">
                                        <i class="fa-solid fa-plane-departure text-warning fs-4"></i>
                                        <span class="small fw-semibold">Air Priority</span>
                                    </label>
                                </div>
                                <div class="col-4">
                                    <input type="radio" class="btn-check" name="freightType" id="modeOcean" value="Ocean" autocomplete="off" checked />
                                    <label class="btn btn-outline-secondary w-100 py-3 text-white d-flex flex-column align-items-center gap-1" for="modeOcean">
                                        <i class="fa-solid fa-ship text-primary fs-4"></i>
                                        <span class="small fw-semibold">Ocean Cargo</span>
                                    </label>
                                </div>
                                <div class="col-4">
                                    <input type="radio" class="btn-check" name="freightType" id="modeLand" value="Land" autocomplete="off" />
                                    <label class="btn btn-outline-secondary w-100 py-3 text-white d-flex flex-column align-items-center gap-1" for="modeLand">
                                        <i class="fa-solid fa-truck-fast text-success fs-4"></i>
                                        <span class="small fw-semibold">Land / Road</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Weight & Cargo Type -->
                        <div class="col-md-6">
                            <label class="form-label text-white small fw-medium">Gross Weight (kg) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number" id="quoteWeight" class="form-control bg-dark text-white border-secondary" min="1" max="100000" value="750" required />
                                <span class="input-group-text bg-dark border-secondary text-white-50">KG</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white small fw-medium">Cargo Category / Commodity</label>
                            <input type="text" id="quoteCargoType" class="form-control bg-dark text-white border-secondary" placeholder="e.g. Commercial Goods, Electronics" value="General Commercial Goods" />
                        </div>

                        <!-- Contact Details for Formal Proforma -->
                        <div class="col-md-6">
                            <label class="form-label text-white small fw-medium">Contact Name</label>
                            <input type="text" id="quoteFullName" class="form-control bg-dark text-white border-secondary" placeholder="Your Name" value="Enterprise Logistics" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white small fw-medium">Corporate Email <span class="text-danger">*</span></label>
                            <input type="email" id="quoteEmail" class="form-control bg-dark text-white border-secondary" placeholder="rates@company.com" value="shipper@company.com" required />
                        </div>

                        <div class="col-12 mt-4">
                            <button type="submit" id="calculateQuoteBtn" class="btn btn-lotka-red w-100 py-3 fw-semibold">
                                <i class="fa-solid fa-calculator me-2"></i> Compute Real-Time Rate in AED
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Right: Real-time Live Quote Output Card in AED -->
            <div class="col-lg-5">
                <div class="quote-summary-card p-4 p-md-5 rounded-4 bg-dark border border-secondary shadow-lg h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="badge bg-success bg-opacity-25 text-success px-3 py-2 rounded-pill fw-bold">Live AI Quote Result</span>
                            <span class="text-white-50 small"><i class="fa-solid fa-shield-halved text-success me-1"></i> Rate Locked 7 Days</span>
                        </div>

                        <div class="mb-4">
                            <div class="text-white-50 small text-uppercase">Estimated Total Commercial Rate</div>
                            <div class="display-4 fw-bold text-warning mb-1" id="quoteDisplayPrice">AED 3,615.00</div>
                            <div class="text-white-50 small" id="quoteDisplaySummary">Ocean Freight from Dubai, UAE (JAFZA) to Rotterdam, Netherlands (750 kg)</div>
                        </div>

                        <div class="rate-breakdown-list mb-4 p-3 rounded glass-panel text-white small">
                            <div class="d-flex justify-content-between py-1 border-bottom border-secondary border-opacity-25">
                                <span class="text-white-50">Transit Estimate</span>
                                <span class="fw-semibold text-info" id="quoteDisplayTransit">14 - 22 Business Days</span>
                            </div>
                            <div class="d-flex justify-content-between py-1 border-bottom border-secondary border-opacity-25">
                                <span class="text-white-50">Customs Clearance & Documentation</span>
                                <span class="fw-semibold text-white">Included (AED 165.00)</span>
                            </div>
                            <div class="d-flex justify-content-between py-1 border-bottom border-secondary border-opacity-25">
                                <span class="text-white-50">Bunker Fuel Index (BAF)</span>
                                <span class="fw-semibold text-white">10% Dynamic Index (AED)</span>
                            </div>
                            <div class="d-flex justify-content-between py-1">
                                <span class="text-white-50">IoT Container Tracking</span>
                                <span class="fw-semibold text-success">Complimentary</span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <button type="button" class="btn btn-primary w-100 py-3 fw-semibold mb-2" onclick="alert('Booking request in AED dispatched to Dubai JAFZA operations team. Booking confirmation code: DXB-' + Math.floor(100000 + Math.random() * 900000));">
                            <i class="fa-solid fa-file-circle-check me-2"></i> Confirm & Book Space Now (AED)
                        </button>
                        <div class="text-center text-white-50 small">
                            Questions? Call Dubai operations at <a href="tel:+97148818618" class="text-white text-decoration-none fw-semibold">+971 4 8818618</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
