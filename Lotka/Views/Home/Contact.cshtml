@{
    ViewData["Title"] = "Contact Us | Dubai JAFZA One Global Headquarters";
}

<!-- ─── HERO: Full-Width Dubai Global Headquarters (Image 4) ─── -->
<section class="lotka-fullwidth-hero">
    <div class="fullwidth-image-wrapper">
        <img src="~/images/contact-ai-robot-desk.jpg"
             alt="LOTKA Dubai Global HQ – AI Specialist at Work"
             class="fullwidth-hero-img" />
        <div class="fullwidth-feature-overlay-contact"></div>
    </div>

    <div class="container-fluid px-4 px-lg-5 hero-content-overlay">
        <div class="min-vh-hero w-100 d-flex align-items-center justify-content-end">
            <div class="col-xl-5 col-lg-6 col-md-8 text-white p-4 p-md-5 rounded-4 glass-panel">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb text-white-50 small mb-2">
                        <li class="breadcrumb-item"><a href="/Home/Index" class="text-white-50 text-decoration-none spa-link" data-page="Index">Home</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Contact Us</li>
                    </ol>
                </nav>
                <span class="badge bg-info text-dark fw-bold mb-2">DUBAI GLOBAL HEADQUARTERS</span>
                <h1 class="display-6 fw-bold mb-3">Lotka Shipping Services LLC</h1>
                <p class="mb-3 text-white-50">
                    Headquartered inside JAFZA One, Jebel Ali Freezone — the Middle East's premier maritime gateway. Licensed Dubai Customs broker with 24/7 multimodal freight coordination with upfront AED tariffs.
                </p>
                <div class="mb-4 small text-white">
                    <div class="mb-1"><i class="fa-solid fa-location-dot text-danger me-2"></i>JAFZA One, Office FZJOBB1906, Jebel Ali, Dubai, UAE &bull; P.O. Box 215142</div>
                    <div class="mb-1"><i class="fa-solid fa-phone text-danger me-2"></i><a href="tel:+97148818618" class="text-info text-decoration-none fw-bold">+971 4 8818618</a></div>
                    <div><i class="fa-solid fa-envelope text-danger me-2"></i><a href="mailto:info@lotka.com" class="text-info text-decoration-none fw-bold">info@lotka.com</a></div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a href="tel:+97148818618" class="btn btn-lotka-red px-3 py-2 fw-semibold">
                        <i class="fa-solid fa-phone me-1"></i> Call Operations Desk
                    </a>
                    <a href="/Home/Quote" class="btn btn-outline-light px-3 py-2 fw-semibold spa-link" data-page="Quote">
                        Instant AED Quote
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ─── Contact Information & Direct Dispatch Form ─── -->
<section class="py-5 bg-navy-alt">
    <div class="container">
        <div class="row g-5 align-items-stretch">
            <!-- Left Column: Dubai Office Information -->
            <div class="col-lg-5">
                <div class="p-4 p-md-5 rounded-4 bg-dark border border-secondary text-white shadow-lg h-100 d-flex flex-column justify-content-between">
                    <div>
                        <span class="badge bg-danger bg-opacity-25 text-danger px-3 py-2 rounded-pill text-uppercase fw-bold letter-spacing-1 mb-2">Corporate Office</span>
                        <h2 class="h4 fw-bold text-white mb-3 d-flex align-items-center gap-2">
                            <i class="fa-solid fa-anchor text-danger"></i> JAFZA One Command Center
                        </h2>

                        <div class="d-flex flex-column gap-3 mb-4">
                            <div class="d-flex align-items-start gap-3">
                                <div class="contact-icon text-danger fs-5"><i class="fa-solid fa-location-dot"></i></div>
                                <div>
                                    <div class="fw-semibold text-white">Physical Location</div>
                                    <div class="text-white-50 small">JAFZA One, Office No: FZJOBB1906</div>
                                    <div class="text-white-50 small">Jebel Ali Freezone, Dubai, UAE</div>
                                    <div class="text-white-50 small">P.O. Box: 215142</div>
                                </div>
                            </div>

                            <div class="d-flex align-items-start gap-3">
                                <div class="contact-icon text-danger fs-5"><i class="fa-solid fa-phone"></i></div>
                                <div>
                                    <div class="fw-semibold text-white">Telephone / Operations Desk</div>
                                    <div><a href="tel:+97148818618" class="text-info fw-semibold text-decoration-none">+971 4 8818618</a></div>
                                </div>
                            </div>

                            <div class="d-flex align-items-start gap-3">
                                <div class="contact-icon text-danger fs-5"><i class="fa-solid fa-envelope"></i></div>
                                <div>
                                    <div class="fw-semibold text-white">Official Correspondence</div>
                                    <div><a href="mailto:info@lotka.com" class="text-info fw-semibold text-decoration-none">info@lotka.com</a></div>
                                </div>
                            </div>

                            <div class="d-flex align-items-start gap-3">
                                <div class="contact-icon text-danger fs-5"><i class="fa-solid fa-clock"></i></div>
                                <div>
                                    <div class="fw-semibold text-white">Operating Hours</div>
                                    <div class="text-white-50 small">Monday &ndash; Friday: 08:00 &ndash; 18:00 GST</div>
                                    <div class="text-white-50 small">24/7/365 Marine Operations Dispatch</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 rounded glass-panel border border-secondary border-opacity-50 small text-white-50">
                        <i class="fa-solid fa-shield-halved text-success me-2"></i> Licensed by Government of Dubai &bull; JAFZA Authority
                    </div>
                </div>
            </div>

            <!-- Right Column: Interactive Dispatch Form -->
            <div class="col-lg-7">
                <div class="p-4 p-md-5 rounded-4 bg-dark border border-secondary shadow-lg h-100 d-flex flex-column">
                    <span class="badge bg-danger bg-opacity-25 text-danger px-3 py-2 rounded-pill text-uppercase fw-bold letter-spacing-1 mb-2 align-self-start">Direct Inquiry</span>
                    <h2 class="h3 fw-bold text-white mb-2">Send Dispatch Inquiry</h2>
                    <p class="text-white-50 small mb-4">Our Dubai freight planners and AI allocation engines will review your cargo requirements and respond within 15 minutes.</p>

                    <div id="contactFormAlert" class="alert d-none" role="alert"></div>

                    <form id="contactForm" class="row g-3 flex-grow-1">
                        <div class="col-md-6">
                            <label class="form-label text-white small fw-medium">Full Name <span class="text-danger">*</span></label>
                            <input type="text" id="contactName" class="form-control bg-dark text-white border-secondary" placeholder="e.g. Sarah Jenkins" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white small fw-medium">Corporate Email <span class="text-danger">*</span></label>
                            <input type="email" id="contactEmail" class="form-control bg-dark text-white border-secondary" placeholder="sarah@company.com" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white small fw-medium">Phone / WhatsApp</label>
                            <input type="tel" id="contactPhone" class="form-control bg-dark text-white border-secondary" placeholder="+971 50 123 4567" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white small fw-medium">Freight Mode</label>
                            <input type="text" id="contactSubject" class="form-control bg-dark text-white border-secondary" placeholder="Ocean / Air / Land / Warehousing" value="Ocean Freight Booking (FCL/LCL)" />
                        </div>
                        <div class="col-12">
                            <label class="form-label text-white small fw-medium">Cargo Specifications &amp; Requirements <span class="text-danger">*</span></label>
                            <textarea id="contactMessage" rows="4" class="form-control bg-dark text-white border-secondary" placeholder="Origin, destination, cargo volume/weight, and timeline requirements in AED..." required></textarea>
                        </div>
                        <div class="col-12 mt-4">
                            <button type="submit" id="contactSubmitBtn" class="btn btn-lotka-red w-100 py-3 fw-semibold">
                                <span class="btn-text"><i class="fa-solid fa-paper-plane me-2"></i> Submit Inquiry to Dubai HQ</span>
                                <span class="btn-spinner d-none"><i class="fa-solid fa-spinner fa-spin me-2"></i> Processing...</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
